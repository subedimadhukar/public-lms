{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "publiclms/checkout",
	"version": "0.4.0",
	"title": "Checkout",
	"category": "publiclms",
	"icon": "cart",
	"description": "Sells a course: order summary, coupon, buyer details and payment method; after payment, the order.",
	"keywords": [
		"checkout",
		"buy",
		"payment",
		"order"
	],
	"textdomain": "public-lms",
	"attributes": {
		"showCoupon": {
			"type": "boolean",
			"default": true
		},
		"gateways": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"default": []
		}
	},
	"supports": {
		"html": false,
		"multiple": false,
		"align": [
			"wide"
		],
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true,
		"interactivity": true
	},
	"editorScript": "file:./index.js",
	"style": [
		"publiclms-tokens",
		"file:./style-index.css"
	],
	"viewScriptModule": "@publiclms/learning",
	"render": "file:./render.php"
}
