{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "publiclms/enroll-button",
	"version": "0.2.0",
	"title": "Enrol Button",
	"category": "publiclms",
	"icon": "button",
	"description": "Lets a learner enrol in a course, or continue where they left off.",
	"keywords": [
		"enroll",
		"enrol",
		"join",
		"start"
	],
	"textdomain": "public-lms",
	"attributes": {
		"courseId": {
			"type": "number",
			"default": 0
		},
		"label": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"showPrice": {
			"type": "boolean",
			"default": true
		}
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true,
		"interactivity": true
	},
	"example": {},
	"editorScript": "file:./index.js",
	"style": [
		"publiclms-tokens",
		"file:./style-index.css"
	],
	"viewScriptModule": "@publiclms/learning",
	"render": "file:./render.php"
}
