{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "publiclms/lesson-content",
	"version": "0.2.0",
	"title": "Lesson Content",
	"category": "publiclms",
	"icon": "media-document",
	"description": "Shows the lesson's content to learners who can open it, and a locked notice to everyone else.",
	"keywords": [
		"content",
		"lesson",
		"locked"
	],
	"textdomain": "public-lms",
	"attributes": {
		"lockedMessage": {
			"type": "string",
			"default": "",
			"role": "content"
		}
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true,
		"layout": true
	},
	"editorScript": "file:./index.js",
	"style": [
		"publiclms-tokens",
		"file:./style-index.css"
	],
	"render": "file:./render.php"
}
