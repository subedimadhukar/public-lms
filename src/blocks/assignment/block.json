{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "publiclms/assignment",
	"version": "0.3.0",
	"title": "Assignment",
	"category": "publiclms",
	"icon": "upload",
	"description": "Lets learners hand in a typed answer and files for an assignment, and shows their grade and feedback.",
	"keywords": [
		"assignment",
		"homework",
		"upload"
	],
	"textdomain": "public-lms",
	"attributes": {
		"assignmentId": {
			"type": "integer",
			"default": 0
		}
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true,
		"interactivity": true
	},
	"editorScript": "file:./index.js",
	"style": [
		"publiclms-tokens",
		"file:./style-index.css"
	],
	"viewScriptModule": "@publiclms/learning",
	"render": "file:./render.php"
}
