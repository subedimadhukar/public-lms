{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Public LMS with CampusInterface",
		"description": "Installs the latest Public LMS release and the CampusInterface theme from its main branch.",
		"author": "WPInterface",
		"categories": [
			"LMS",
			"Education"
		]
	},
	"landingPage": "/wp-admin/edit.php?post_type=plms_course",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/subedimadhukar/public-lms/releases/latest/download/public-lms.zip"
			},
			"options": {
				"activate": true,
				"targetFolderName": "public-lms"
			}
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "git:directory",
				"url": "https://github.com/subedimadhukar/campusinterface",
				"ref": "main",
				"refType": "branch",
				"path": "/"
			},
			"options": {
				"activate": true,
				"targetFolderName": "campusinterface"
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Public LMS demo"
			}
		}
	]
}
